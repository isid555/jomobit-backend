# Coverage configuration for Jest
[run]
source = src/
omit = 
    */node_modules/*
    */tests/*
    */coverage/*
    */dist/*
    */build/*
    server.js

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = coverage/html

[xml]
output = coverage/coverage.xml