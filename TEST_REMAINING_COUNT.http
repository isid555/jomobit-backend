### Test 1: Unlimited Yearly → Monthly (Scheduled Downgrade)
# Expected: remaining_count = 0 (keeps unlimited)
POST http://localhost:3000/api/subscriptions/upgrade
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "newPlanId": "pro_monthly",
  "immediate": false,
  "reason": "test_unlimited_yearly_to_monthly"
}

###

### Test 2: Unlimited Monthly → Yearly (Immediate Upgrade)
# Expected: remaining_count = 0 (keeps unlimited)
POST http://localhost:3000/api/subscriptions/upgrade
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "newPlanId": "pro_annual",
  "immediate": true,
  "reason": "test_unlimited_monthly_to_yearly"
}

###

### Test 3: Same Interval Change (Monthly → Monthly)
# Expected: remaining_count NOT included
POST http://localhost:3000/api/subscriptions/upgrade
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "newPlanId": "max_monthly",
  "immediate": true,
  "reason": "test_same_interval"
}

###

### Test 4: Limited Yearly → Monthly (Scheduled)
# Setup: Create subscription with totalCount = 2, remainingCount = 1
# Expected: remaining_count = 12 (365 days / 30 days)
POST http://localhost:3000/api/subscriptions/upgrade
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "newPlanId": "pro_monthly",
  "immediate": false,
  "reason": "test_limited_yearly_to_monthly"
}

###

### Test 5: Limited Monthly → Yearly (Immediate)
# Setup: Create subscription with totalCount = 12, remainingCount = 9
# Expected: remaining_count = 1 (270 days / 365 days, rounded up)
POST http://localhost:3000/api/subscriptions/upgrade
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "newPlanId": "pro_annual",
  "immediate": true,
  "reason": "test_limited_monthly_to_yearly"
}

###

### Test 6: Downgrade with immediate=true (Should be forced to scheduled)
# Expected: immediate flag overridden to false, remaining_count calculated for scheduled
POST http://localhost:3000/api/subscriptions/upgrade
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "newPlanId": "basic_monthly",
  "immediate": true,
  "reason": "test_downgrade_forced_scheduled"
}

###
